# Keep local and temporary check scripts out of the repository; stable regressions use *.verify.* via npm test.
*.check.ts
*.check.mjs
# Keep the external MCP bridge protocol regression with its implementation; the legacy name is intentional.
!server/external-agent/broker.check.ts

# Local development and verification scripts.
# `/scripts/*` rather than `/scripts/`: git never re-includes files inside an
# ignored DIRECTORY, so with the old form every `!` line below was inert and
# new canonical scripts could only enter the repo via `git add -f` — a new
# scripts/*.verify.mjs registered in package.json was silently skipped by
# `git add -A`, and CI died with MODULE_NOT_FOUND on a file that exists locally.
/scripts/*
!/scripts/sync-mediapipe.mjs
!/scripts/package-windows.mjs
!/scripts/verify-packaged-isolated.mjs
!/scripts/generated-edit-benchmark.mts
!/scripts/run-standard-verification.mjs
!/scripts/verification-report.mjs
!/scripts/verification-manifest.json
!/scripts/verification-inventory.mjs
!/scripts/verification-runner.mjs
!/scripts/verification-process.mjs
!/scripts/benchmark-result-identity.mjs
!/scripts/desktop-workflow-host.mjs
!/scripts/chapter-render-bundle.mjs
!/scripts/chapter-render-bundle.d.mts
!/scripts/test-artifacts.mjs
!/scripts/verify-jianying-workflow.mjs
!/scripts/font-animation-short-probe.mjs
!/scripts/jianying-workflow-ui-server.mjs
!/scripts/jianying-workflow-electron.mts
!/scripts/launch-mask-drag-ui.mjs
!/scripts/verify-mask-drag-regression.mjs
!/scripts/fixtures/
/scripts/fixtures/*
!/scripts/fixtures/jianying-workflow-ui.tsx
!/scripts/fixtures/jianying-workflow-ui.html
!/scripts/fixtures/mask-drag-ui.tsx
!/scripts/fixtures/mask-drag-ui.html
!/scripts/chapter-render-frames.mjs
!/scripts/chapter-transition-audit.mjs
!/scripts/long-video-*.mts
!/scripts/long-video-*.mjs
!/scripts/long-video-*.tsx
!/scripts/long-video-*.ts
!/scripts/long-video-*.html
# Stable regressions are *.verify.* by convention (see the *.check.* rule
# above), so they are never local-only.
!/scripts/*.verify.*


    "prebuild": "npm run sync:mediapipe && npm run verify:server-tool-catalog",
    "prepare:runtime:win": "node scripts/sync-whisper-cli.mjs --offline",
    "build": "tsc -b && vite build --config config/vite.config.ts",
    "update:model-capabilities": "node --use-env-proxy scripts/update-llm-model-capabilities.mjs",
    "verify:affected": "node scripts/run-affected-verifies.mjs",
    "verify:architecture-first-round": "node scripts/run-standard-verification.mjs --suite=verify:architecture-first-round",
    "verify:media-drag": "node scripts/run-standard-verification.mjs --suite=verify:media-drag",
    "verify:semantic-sampling": "node scripts/run-standard-verification.mjs --suite=verify:semantic-sampling",
    "verify:runtime-profile": "node scripts/run-standard-verification.mjs --suite=verify:runtime-profile",

{
  "name": "openchatcut",
  "private": true,
  "version": "0.4.0",
  "description": "Local-first video editor with external MCP control for Codex.",
  "license": "AGPL-3.0-or-later",
  "author": "OpenChatCut Contributors",
  "type": "module",
  "main": "desktop-dist/main.mjs",
  "desktopName": "openchatcut.desktop",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "verify:mask-blur": "node scripts/run-standard-verification.mjs --suite=verify:mask-blur",
    "verify:mask-blur-render": "node scripts/run-standard-verification.mjs --suite=verify:mask-blur-render",

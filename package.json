    "verify:skills": "node scripts/run-standard-verification.mjs --suite=verify:skills",
    "verify:speech-providers": "node scripts/run-standard-verification.mjs --suite=verify:speech-providers",
    "verify:model-persistence-restart": "node scripts/run-standard-verification.mjs --suite=verify:model-persistence-restart",

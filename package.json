    "verify:media-persist": "node scripts/run-standard-verification.mjs --suite=verify:media-persist",
    "verify:export-gl": "node scripts/run-standard-verification.mjs --suite=verify:export-gl",
    "verify:filmstrip": "node scripts/run-standard-verification.mjs --suite=verify:filmstrip",
    "verify:server-extra": "node scripts/run-standard-verification.mjs --suite=verify:server-extra",
    "verify:sqlite-migration": "node scripts/run-standard-verification.mjs --suite=verify:sqlite-migration",
    "verify:extract-audio": "node scripts/run-standard-verification.mjs --suite=verify:extract-audio",
    "test:logic": "node scripts/run-standard-verification.mjs --group=logic",
    "test:short-render": "node scripts/run-standard-verification.mjs --group=short-render",
    "test:desktop": "node scripts/run-standard-verification.mjs --group=desktop",
    "test:package": "node scripts/run-standard-verification.mjs --group=package",
    "test:long": "node scripts/run-standard-verification.mjs --group=long",
    "verify:standard": "node scripts/run-standard-verification.mjs"

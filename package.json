    "preview": "vite preview --config config/vite.config.ts",
    "desktop:build:main": "esbuild desktop/bootstrap.ts --bundle --platform=node --format=esm --packages=external --external:./app-main.mjs --sourcemap --outfile=desktop-dist/main.mjs && esbuild desktop/main.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=desktop-dist/app-main.mjs && esbuild desktop/native-asr-worker.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=desktop-dist/native-asr-worker.mjs && esbuild desktop/native-semantic-worker.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=desktop-dist/native-semantic-worker.mjs && esbuild desktop/native-clap-worker.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=desktop-dist/native-clap-worker.mjs && esbuild desktop/native-rhythm-worker.ts --bundle --platform=node --format=esm --packages=external --sourcemap --outfile=desktop-dist/native-rhythm-worker.mjs && esbuild desktop/preload.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=desktop-dist/preload.cjs",
    "desktop:dev": "node scripts/dev-profile.mjs --exec npm run desktop:dev:shared",
    "desktop:dev:shared": "npm run desktop:build:main && electron desktop-dist/main.mjs",
    "desktop:smoke": "npm run desktop:build:main && CC_SMOKE=1 electron desktop-dist/main.mjs",
    "desktop:prebundle": "tsx desktop/prebuild-remotion.mts",
    "desktop:dist": "npm run sync:whisper-cli && npm run build && npm run desktop:build:main && npm run desktop:prebundle && tsx desktop/prepare-target.mts darwin-arm64 && CC_EB_TARGET=darwin-arm64 electron-builder --config config/electron-builder.config.mjs --mac --arm64 --publish never",
    "desktop:dist:local": "npm run sync:whisper-cli && npm run build && npm run desktop:build:main && npm run desktop:prebundle && tsx desktop/prepare-target.mts darwin-arm64 && CC_EB_TARGET=darwin-arm64 electron-builder --config config/electron-builder.config.mjs --mac --arm64 --dir --publish never",
    "desktop:prepare": "tsx desktop/prepare-target.mts",
    "desktop:dist:mac-x64": "npm run sync:whisper-cli && npm run build && npm run desktop:build:main && npm run desktop:prebundle && tsx desktop/prepare-target.mts darwin-x64 && CC_EB_TARGET=darwin-x64 electron-builder --config config/electron-builder.config.mjs --mac --x64 --publish never",
    "desktop:dist:win": "npm run prepare:runtime:win && npm run build && npm run desktop:build:main && npm run desktop:prebundle && tsx desktop/prepare-target.mts win32-x64 && node scripts/package-windows.mjs",
    "desktop:dist:linux": "npm run sync:whisper-cli && npm run build && npm run desktop:build:main && npm run desktop:prebundle && tsx desktop/prepare-target.mts linux-x64 && CC_EB_TARGET=linux-x64 electron-builder --config config/electron-builder.config.mjs --linux AppImage --x64 --publish never",
    "verify:shortcuts": "node scripts/run-standard-verification.mjs --suite=verify:shortcuts",
    "verify:i18n": "node scripts/run-standard-verification.mjs --suite=verify:i18n",
    "verify:zuoren-roundtrip": "node scripts/run-standard-verification.mjs --suite=verify:zuoren-roundtrip",
    "verify:zuoren-40min": "node scripts/run-standard-verification.mjs --suite=verify:zuoren-40min",
    "verify:chapter-render-audit": "node scripts/run-standard-verification.mjs --suite=verify:chapter-render-audit",
    "verify:render-browser": "node scripts/run-standard-verification.mjs --suite=verify:render-browser",
    "verify:transition-placement": "node scripts/run-standard-verification.mjs --suite=verify:transition-placement",
    "verify:chapter-animation-render": "node scripts/run-standard-verification.mjs --suite=verify:chapter-animation-render",
    "verify:chapter-transitions-render": "node scripts/run-standard-verification.mjs --suite=verify:chapter-transitions-render",
